[env:esp32dev]
platform = espressif32
board = esp32dev
framework = arduino
monitor_speed = 115200

lib_deps = 
	bodmer/TFT_eSPI@^2.5.43
	paulstoffregen/XPT2046_Touchscreen

build_flags =
    -D USER_SETUP_LOADED=1
    -D ST7796_DRIVER=1        ; Driver untuk CYD 3.5"
    -D TFT_MISO=12
    -D TFT_MOSI=13
    -D TFT_SCLK=14
    -D TFT_CS=15
    -D TFT_DC=2
    -D TFT_RST=-1
    -D TFT_BL=27              ; Pin Backlight CYD 3.5" adalah GPIO 27 (Berbeda dengan 2.8")
    -D TFT_BACKLIGHT_ON=HIGH
    -D TOUCH_CS=33            ; Pin Touch Chip Select
    -D LOAD_GLCD=1
    -D LOAD_FONT2=1
    -D LOAD_FONT4=1
    -D LOAD_FONT6=1
    -D LOAD_FONT7=1
    -D LOAD_FONT8=1
    -D LOAD_GFXFF=1
    -D SMOOTH_FONT=1
    -D SPI_FREQUENCY=27000000 ; Diturunkan ke 27MHz agar layar ST7796 lebih stabil
    -D SPI_READ_FREQUENCY=20000000
    -D SPI_TOUCH_FREQUENCY=25000000
